      ]
    }
  ],
  "outputs": {
    "appInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-ai', parameters('appName'))), '2020-02-02').ConnectionString]"
    },
    "manualContainerAppJobName": {
      "type": "string",
      "value": "[format('{0}-manual-job', parameters('appName'))]"
    },
    "scheduledContainerAppJobName": {
