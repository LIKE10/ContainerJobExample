        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName')))]",
        "configuration": {
          "triggerType": "Schedule",
          "replicaTimeout": 600,
          "replicaRetryLimit": 1,
          "scheduleTriggerConfig": {
            "cronExpression": "[parameters('scheduledJobCron')]",
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "registries": [
            {
              "server": "[parameters('containerRegistryServer')]",
              "identity": "[parameters('managedIdentityResourceId')]"
            }
          ],
          "secrets": [
            {
              "name": "appinsights-connection-string",
              "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-ai', parameters('appName'))), '2020-02-02').ConnectionString]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "scheduledexample",
              "image": "[parameters('scheduledContainerImage')]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
