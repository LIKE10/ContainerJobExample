            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-law', parameters('appName'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-law', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.App/jobs",
      "apiVersion": "2025-10-02-preview",
      "name": "[format('{0}-manual-job', parameters('appName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('managedIdentityResourceId'))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName')))]",
        "configuration": {
          "triggerType": "Manual",
          "replicaTimeout": 600,
          "replicaRetryLimit": 1,
          "registries": [
            {
              "server": "[parameters('containerRegistryServer')]",
